      "target": "api::project-company-participation.project-company-participation",
      "mappedBy": "Project"
    },
    "Workmen": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project-personal-participation.project-personal-participation",
      "mappedBy": "Project"
    },
    "Category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project-category.project-category",
      "inversedBy": "Projects"
    },
    "CoverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }

{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true,
      "pluginOptions": {},
      "maxLength": 50
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {}
    },
    "Description": {
      "type": "text",
      "pluginOptions": {}
    },
    "Location": {
      "type": "component",
      "repeatable": false,
      "component": "location.coordinates",
      "pluginOptions": {}
    },
    "Employment_records": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::work-experience.work-experience",
      "mappedBy": "Company"
    },
    "Projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project-company-participation.project-company-participation",
      "mappedBy": "Company"
    },
    "Industry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::industry.industry",
      "inversedBy": "Companies"
    },
    "Website": {
      "type": "string",
      "maxLength": 100
    },
    "Address": {
      "type": "text"
    },
    "Phone": {
      "type": "string",
      "regex": "/^\\d+$/",
      "required": false
    },
    "CoverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "Email": {
      "type": "email",
      "required": false,
      "maxLength": 50
    }
  }
}

      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "DOB": {
      "type": "date"
    },
    "Work_Experiences": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::work-experience.work-experience",
      "mappedBy": "Employee"
    },
    "Projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project-personal-participation.project-personal-participation",
      "mappedBy": "Employee"
    },
    "Educations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::education.education",
      "mappedBy": "Student"
    },
    "Email": {
      "type": "email",
      "maxLength": 50
    },
    "Phone": {
      "type": "string"
    },
    "Certificates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::certificate.certificate",
      "mappedBy": "Employee"
